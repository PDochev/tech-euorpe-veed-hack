{
  "target": "https://opensource-demo.orangehrmlive.com",
  "capabilities": [
    {
      "name": "Dashboard",
      "description": "Main overview screen with Time at Work, My Actions, Quick Launch, and employee metrics",
      "url": "https://opensource-demo.orangehrmlive.com/web/index.php/dashboard/index",
      "source": "h"
    },
    {
      "name": "System Users Management",
      "description": "List and filter system users with search and add capabilities",
      "url": "https://opensource-demo.orangehrmlive.com/web/index.php/admin/viewSystemUsers",
      "source": "h"
    },
    {
      "name": "Job Titles Management",
      "description": "List 28 job titles with search, filter, and CRUD operations",
      "url": "https://opensource-demo.orangehrmlive.com/web/index.php/admin/viewJobTitleList",
      "source": "h"
    },
    {
      "name": "Pay Grades Management",
      "description": "List and configure 5 pay grades with grade ranges",
      "url": "https://opensource-demo.orangehrmlive.com/web/index.php/admin/viewPayGrades",
      "source": "h"
    },
    {
      "name": "Organization Structure",
      "description": "Visual company hierarchy with sub-unit management",
      "url": "https://opensource-demo.orangehrmlive.com/web/index.php/admin/viewCompanyStructure",
      "source": "h"
    },
    {
      "name": "Skills Management",
      "description": "List 21 skills with search and categorization",
      "url": "https://opensource-demo.orangehrmlive.com/web/index.php/admin/viewSkills",
      "source": "h"
    },
    {
      "name": "Employee List (PIM)",
      "description": "Browse and filter employee records with search by name, title, location",
      "url": "https://opensource-demo.orangehrmlive.com/web/index.php/pim/viewEmployeeList",
      "source": "h"
    },
    {
      "name": "Directory",
      "description": "Employee contact directory with 135 records, searchable by name, job title, and location",
      "url": "https://opensource-demo.orangehrmlive.com/web/index.php/directory/viewDirectory",
      "source": "h"
    },
    {
      "name": "Edit company basic information",
      "description": "Update the organization’s core company details from the Admin module and save the changes.",
      "source": "tavily"
    },
    {
      "name": "Configure company structure",
      "description": "Define departments, organizational units, and other company structure settings.",
      "source": "tavily"
    },
    {
      "name": "Manage job titles and job descriptions",
      "description": "Create or update job titles and their associated descriptions for the organization.",
      "source": "tavily"
    },
    {
      "name": "Set up pay grades",
      "description": "Define pay grade levels used in the HR system.",
      "source": "tavily"
    },
    {
      "name": "Manage user access rights and roles",
      "description": "Create and assign roles or permissions to control what users can access in the system.",
      "source": "tavily"
    },
    {
      "name": "Configure security settings",
      "description": "Adjust system security-related settings that affect administrative access and control.",
      "source": "tavily"
    },
    {
      "name": "Manage skills and qualifications",
      "description": "Add and maintain skills and qualification records used in HR profiles.",
      "source": "tavily"
    },
    {
      "name": "Set up customer and project records",
      "description": "Create and maintain customer and project entries in the Admin module.",
      "source": "tavily"
    },
    {
      "name": "Maintain employee contact and emergency information",
      "description": "View or edit contact details, emergency contacts, and dependent information for employees.",
      "source": "tavily"
    },
    {
      "name": "Manage employee immigration records",
      "description": "Add and update immigration information and documents for employees.",
      "source": "tavily"
    }
  ],
