{
  "target": "https://opensource-demo.orangehrmlive.com",
  "tools": [
    {
      "name": "search_system_users",
      "description": "Search OrangeHRM admin system users by username and return matching user records.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "Username to search for."
          }
        },
        "required": []
      },
      "recipe": [
        {
          "action": "goto",
          "value": "https://opensource-demo.orangehrmlive.com/web/index.php/admin/viewSystemUsers"
        },
        {
          "action": "fill",
          "selector": "div.oxd-input-group:has-text(\"Username\") >> input",
          "arg": "username"
        },
        {
          "action": "click",
          "selector": "button:has-text(\"Search\")"
        },
        {
          "action": "wait",
          "ms": 2000
        },
        {
          "action": "read",
          "selector": "div.oxd-table-body"
        }
      ],
      "readSelector": "div.oxd-table-body",
      "derivedFrom": [
        "s1"
      ]
    },
